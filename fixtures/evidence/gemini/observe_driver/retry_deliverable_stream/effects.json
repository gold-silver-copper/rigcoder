        "key": "tool:read_file",
        "family": {
          "family": "tool",
          "name": "read_file",
          "description": "Read a text file. Returns its lines numbered from 1. A file over 2000 lines read without offset/limit returns an outline (definitions with line numbers) instead; then read the ranges you need.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "File path, absolute or relative to the workspace"
              },
              "offset": {
                "type": "integer",
                "description": "First line to return (1-based, default 1)"
              },
              "limit": {
                "type": "integer",
                "description": "Maximum lines to return (default 2000)"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      {
        "key": "tool:write_file",
        "family": {
          "family": "tool",
          "name": "write_file",
          "description": "Create or overwrite a file with the given content. Parent directories are created. New files are private; replacements preserve existing permissions. Read-only and hard-linked targets are refused.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ]
          }
        }
      },
      {
        "key": "tool:edit_file",
        "family": {
          "family": "tool",
          "name": "edit_file",
          "description": "Replace an exact string in a file. old_string must match exactly once unless replace_all is true. Returns the lines around each replacement as they now read.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "old_string": {
                "type": "string",
                "description": "Exact text to find (include enough context to be unique)"
              },
              "new_string": {
                "type": "string",
                "description": "Replacement text"
              },
              "replace_all": {
                "type": "boolean",
                "description": "Replace every occurrence (default false)"
              }
            },
            "required": [
              "path",
              "old_string",
              "new_string"
            ]
          }
        }
      },
      {
        "key": "tool:list_files",
        "family": {
          "family": "tool",
          "name": "list_files",
          "description": "List files under a directory (recursively, honoring .gitignore). Directories end with '/'.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Directory (default: the workspace)"
              },
              "max_depth": {
                "type": "integer",
                "description": "Recursion depth (default 3)"
              },
              "limit": {
                "type": "integer",
                "description": "Maximum entries (default 500)"
              }
            }
          }
        }
      },
      {
        "key": "tool:grep",
        "family": {
          "family": "tool",
          "name": "grep",
          "description": "Search file contents with a regular expression (Rust regex syntax). Returns path:line:text matches.",
          "parameters": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "File or directory to search (default: the workspace)"
              },
              "glob": {
                "type": "string",
                "description": "Only files matching this glob, e.g. *.rs"
              },
              "limit": {
                "type": "integer",
                "description": "Maximum matches (default 200)"
              }
            },
            "required": [
              "pattern"
            ]
          }
        }
      },
